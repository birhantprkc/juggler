#!/usr/bin/env bash
#
# Ensure the golangci-lint at $(go env GOPATH)/bin is exactly the version the
# Makefile pins in GOLANGCI_LINT_VERSION, installing it if it is missing or a
# different version.
#
# The pin only means something if it is enforced: linter releases change the
# rule set and the false-positive surface, and a stale local binary silently
# disagrees with CI. Checking that the binary merely EXISTS is not enough --
# it leaves whatever version happened to be installed first in charge, forever.
#
# The version check is against GOPATH/bin specifically, because that is the
# copy the lint targets invoke by absolute path. A golangci-lint elsewhere on
# PATH (Homebrew, distro package) is irrelevant to them and is ignored here.
#
# Used by the Makefile's lint-go / fix-go and by scripts/lint-files. Never
# install golangci-lint by hand -- go through this, or the pin drifts.

set -euo pipefail

if [ -z "${GOLANGCI_LINT_VERSION:-}" ]; then
	echo "ensure-golangci-lint: GOLANGCI_LINT_VERSION is not set" >&2
	exit 1
fi

bin="$(go env GOPATH)/bin/golangci-lint"
want="${GOLANGCI_LINT_VERSION#v}"
have=""

# "golangci-lint has version 2.13.2 built with go1.26.3 from ... on ..."
if [ -x "$bin" ]; then
	have="$("$bin" version 2>/dev/null | sed -n 's/.*has version \([^ ]*\).*/\1/p')"
fi

if [ "$have" != "$want" ]; then
	echo "Installing golangci-lint $GOLANGCI_LINT_VERSION (found: ${have:-none})..."
	go install "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@$GOLANGCI_LINT_VERSION"
fi
