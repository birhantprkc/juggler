{
  "id": "@juggler/exa",
  "name": "Exa Search",
  "version": "0.1.0",
  "author": "Juggler Team",
  "homepage": "https://exa.ai",
  "license": "Apache-2.0",
  "engineApi": "^1.0.0",
  "permissions": [
    "network.http:api.exa.ai"
  ],
  "settings": [
    {
      "key": "api_key",
      "type": "secret",
      "label": "Exa API key",
      "help": "Create an API key at https://dashboard.exa.ai/api-keys",
      "required": true
    }
  ],
  "provides": {
    "contextItems": ["context-items/*-context-item.js"],
    "tests": ["_tests/*-test.js"]
  }
}
