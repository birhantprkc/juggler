{
  "id": "@juggler/core",
  "name": "Juggler Core",
  "version": "1.0.0",
  "author": "Juggler Team",
  "homepage": "https://juggler.studio",
  "license": "Apache-2.0",
  "engineApi": "^1.0.0",
  "permissions": [
    "filesystem.read",
    "filesystem.write",
    "shell.exec",
    "web.fetch"
  ],
  "provides": {
    "contextItems": ["context-items/*-context-item.js"],
